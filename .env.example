# Copy to backend/.env and fill in real values. Never commit the real .env.
# Every setting is optional unless marked REQUIRED. See docs/deployment.md.

# --- App ---
VOICEFLOW_APP_NAME="VoiceFlow"
VOICEFLOW_ENVIRONMENT=development        # development | test | production
VOICEFLOW_DEFAULT_TIMEZONE=Asia/Kolkata
# Origins allowed to call the API with cookies. In production: your HTTPS address only.
VOICEFLOW_CORS_ORIGINS=["http://localhost:5173"]
VOICEFLOW_LOG_LEVEL=INFO

# --- Database (PostgreSQL) --- REQUIRED
VOICEFLOW_DATABASE_URL=postgresql+psycopg://voiceflow:CHANGE_ME@localhost:5432/voiceflow
# Only for running the automated tests (this database is wiped by the tests).
VOICEFLOW_TEST_DATABASE_URL=postgresql+psycopg://voiceflow:CHANGE_ME@localhost:5432/voiceflow_test

# --- Sessions and sign-in ---
VOICEFLOW_SESSION_ABSOLUTE_HOURS=12      # signed out this long after signing in
VOICEFLOW_SESSION_IDLE_MINUTES=120       # signed out after this long without activity
# Secure cookies (HTTPS only). Leave unset: on automatically when ENVIRONMENT=production.
# VOICEFLOW_SESSION_COOKIE_SECURE=true
VOICEFLOW_LOGIN_MAX_FAILURES=5
VOICEFLOW_LOGIN_FAILURE_WINDOW_MINUTES=15

# --- Voice (local speech recognition) ---
VOICEFLOW_STT_PROVIDER=onnx-whisper      # onnx-whisper | faster-whisper | disabled
# onnx-whisper model folder; fill it with: python -m app.cli.fetch_stt_model
VOICEFLOW_STT_MODEL_DIR=D:/ai-cache/models/whisper-base.en-onnx
# VOICEFLOW_STT_MODEL=base.en            # faster-whisper only (downloaded to HF_HOME)
VOICEFLOW_STT_CPU_THREADS=4
VOICEFLOW_STT_MAX_SECONDS=20             # longest recording accepted
VOICEFLOW_VOICE_TURNS_PER_MINUTE=30      # per person
